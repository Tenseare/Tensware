-- War Tycoon Mobile Sprint
-- StarterPlayer > StarterPlayerScripts > LocalScript
-- Aim + downed only. No crouch detection. No weapon scanning.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local NORMAL_SPEED = 16
local AIM_SPEED = 14
local DEFAULT_MULTIPLIER = 2
local MIN_MULTIPLIER = 1
local MAX_MULTIPLIER = 5
local CHECK_INTERVAL = 0.25

local sprintEnabled = false
local multiplier = DEFAULT_MULTIPLIER
local controlsVisible = true

local character, humanoid
local stateConnections = {}
local trackedValues = {}
local trackedAttributes = {}
local lastAppliedSpeed

local AIM_NAMES = {
    "IsAiming", "Aiming", "IsAim", "Aim",
    "Scoped", "IsScoped", "ADS", "IsADS",
    "AimDownSights", "IsAimDownSights",
    "AimingDownSights", "IsZoomed", "Zoomed",
    "IsZooming", "Zooming", "AimMode"
}

local DOWNED_NAMES = {
    "IsDowned", "Downed", "Down", "IsKnocked",
    "Knocked", "KnockedDown", "IsKnockedDown",
    "Incapacitated", "IsIncapacitated",
    "IsUnconscious", "Unconscious",
    "BeingCarried", "IsBeingCarried",
    "IsRagdolled", "Ragdolled", "DownedState"
}

local function normalize(name)
    return string.lower(tostring(name)):gsub("[^%w]", "")
end

local function matches(name, list)
    name = normalize(name)
    for _, candidate in ipairs(list) do
        if name == normalize(candidate) then
            return true
        end
    end
    return false
end

local function classify(name)
    if matches(name, AIM_NAMES) then
        return "aim"
    elseif matches(name, DOWNED_NAMES) then
        return "downed"
    end
end

local function isTrueValue(object)
    if object:IsA("BoolValue") then
        return object.Value
    elseif object:IsA("NumberValue") or object:IsA("IntValue") then
        return object.Value ~= 0
    elseif object:IsA("StringValue") then
        local value = normalize(object.Value)
        return value == "true" or value == "yes"
            or value == "1" or value == "active"
            or value == "aiming" or value == "downed"
            or value == "knocked"
    end
    return false
end

local function attributeIsTrue(value)
    if typeof(value) == "boolean" then
        return value
    elseif typeof(value) == "number" then
        return value ~= 0
    elseif typeof(value) == "string" then
        local v = normalize(value)
        return v == "true" or v == "yes"
            or v == "1" or v == "active"
            or v == "aiming" or v == "downed"
            or v == "knocked"
    end
    return false
end

local function trackObject(object)
    local kind = classify(object.Name)
    if kind and (
        object:IsA("BoolValue")
        or object:IsA("StringValue")
        or object:IsA("NumberValue")
        or object:IsA("IntValue")
    ) then
        trackedValues[object] = kind
    end
end

local function trackAttributes(container)
    local attributes = {}

    for name in pairs(container:GetAttributes()) do
        local kind = classify(name)
        if kind then
            attributes[name] = kind
        end
    end

    trackedAttributes[container] = attributes
end

local function addContainer(container)
    trackAttributes(container)

    -- Scan only player/character at spawn, never equipped weapons.
    for _, object in ipairs(container:GetDescendants()) do
        trackObject(object)
    end

    table.insert(stateConnections, container.DescendantAdded:Connect(function(object)
        trackObject(object)
    end))

    table.insert(stateConnections, container.DescendantRemoving:Connect(function(object)
        trackedValues[object] = nil
    end))

    table.insert(stateConnections, container.AttributeChanged:Connect(function(name)
        local kind = classify(name)
        if kind then
            trackedAttributes[container] = trackedAttributes[container] or {}
            trackedAttributes[container][name] = kind
        end
    end))
end

local function clearTracking()
    for _, connection in ipairs(stateConnections) do
        connection:Disconnect()
    end

    table.clear(stateConnections)
    table.clear(trackedValues)
    table.clear(trackedAttributes)
end

local function readStates()
    local aiming, downed = false, false

    for object, kind in pairs(trackedValues) do
        if object.Parent and isTrueValue(object) then
            if kind == "aim" then
                aiming = true
            else
                downed = true
            end

            if aiming and downed then
                break
            end
        end
    end

    for container, attributes in pairs(trackedAttributes) do
        if container.Parent then
            for name, kind in pairs(attributes) do
                if attributeIsTrue(container:GetAttribute(name)) then
                    if kind == "aim" then
                        aiming = true
                    else
                        downed = true
                    end
                end
            end
        end
    end

    return aiming, downed
end

