local function updateUI()
    sprintButton.Text = sprintEnabled and "SPRINT: ON" or "SPRINT: OFF"
    sprintButton.BackgroundColor3 = sprintEnabled
        and Color3.fromRGB(20, 125, 55)
        or Color3.fromRGB(35, 35, 35)

    multiplierLabel.Text = string.format(
        "Multiplier: %.2fx | Speed: %.1f",
        multiplier, NORMAL_SPEED * multiplier
    )

    visibilityButton.Text = controlsVisible
        and "HIDE CONTROLS" or "SHOW CONTROLS"
end

local function makeDraggable(object, handle)
    handle = handle or object
    local dragging = false
    local dragStart
    local startPosition

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = object.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            object.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)
end

makeDraggable(sprintButton)
makeDraggable(menuButton)
makeDraggable(menu, title)

local function bindCharacter(newCharacter)
    clearTracking()

    character = newCharacter
    humanoid = character:WaitForChild("Humanoid")
    lastAppliedSpeed = nil
    sprintEnabled = false

    addContainer(player)
    addContainer(character)

    updateUI()
end

player.CharacterAdded:Connect(bindCharacter)
if player.Character then
    task.spawn(bindCharacter, player.Character)
end

sprintButton.Activated:Connect(function()
    sprintEnabled = not sprintEnabled
    lastAppliedSpeed = nil
    updateUI()
end)

menuButton.Activated:Connect(function()
    menu.Visible = not menu.Visible
end)

minusButton.Activated:Connect(function()
    multiplier = math.max(MIN_MULTIPLIER, multiplier - 0.25)
    lastAppliedSpeed = nil
    updateUI()
end)

plusButton.Activated:Connect(function()
    multiplier = math.min(MAX_MULTIPLIER, multiplier + 0.25)
    lastAppliedSpeed = nil
    updateUI()
end)

visibilityButton.Activated:Connect(function()
    controlsVisible = not controlsVisible
    sprintButton.Visible = controlsVisible
    menuButton.Visible = controlsVisible
    menu.Visible = controlsVisible and menu.Visible
    updateUI()
end)

-- Only poll cached states four times per second.
task.spawn(function()
    while gui.Parent do
        task.wait(CHECK_INTERVAL)

        if not humanoid or not humanoid.Parent or humanoid.Health <= 0 then
            continue
        end

        local aiming, downed = readStates()

        if downed then
            statusLabel.Text = "DOWNED"
            lastAppliedSpeed = nil
            continue
        end

        local targetSpeed
        if aiming then
            targetSpeed = AIM_SPEED
            statusLabel.Text = "AIMING"
        elseif sprintEnabled then
            targetSpeed = NORMAL_SPEED * multiplier
            statusLabel.Text = "SPRINTING"
        else
            targetSpeed = NORMAL_SPEED
            statusLabel.Text = "NORMAL"
        end

        if targetSpeed ~= lastAppliedSpeed
            or math.abs(humanoid.WalkSpeed - targetSpeed) > 0.1 then
            humanoid.WalkSpeed = targetSpeed
            lastAppliedSpeed = targetSpeed
        end
    end
end)

updateUI()
