-- Lightweight speed controller
-- Integrate with your existing buttons and state flags.
local NORMAL_SPEED = 16
local AIM_SPEED = 14
local CROUCH_SPEED = 8
local MULTIPLIER = 2
local sprintEnabled = false
local aiming = false
local crouching = false
local downed = false
local player = game:GetService("Players").LocalPlayer
local humanoid
local lastSpeed
local function bindCharacter(character)
    humanoid = character:WaitForChild("Humanoid")
    lastSpeed = nil
end
player.CharacterAdded:Connect(bindCharacter)
if player.Character then
    task.spawn(bindCharacter, player.Character)
end
-- Call this from your existing aim/crouch/downed detection
-- whenever a state changes. Do not scan descendants here.
local function updateSpeed()
    if not humanoid or humanoid.Health <= 0 or downed then
        lastSpeed = nil
        return
    end
    local target
    if aiming then
        target = AIM_SPEED
    elseif crouching then
        target = CROUCH_SPEED
    elseif sprintEnabled then
        target = NORMAL_SPEED * MULTIPLIER
    else
        target = NORMAL_SPEED
    end
    if target ~= lastSpeed then
        humanoid.WalkSpeed = target
        lastSpeed = target
    end
end
-- Poll only for character availability; speed changes are event-driven.
task.spawn(function()
    while true do
        task.wait(1)
        if humanoid and humanoid.Parent then
            updateSpeed()
        end
    end
end)
